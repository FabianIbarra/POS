<Application
    x:Class="POS.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:POS.Helpers"
    xmlns:local="clr-namespace:POS"
    StartupUri="Views/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Inputs.xaml" />
                <ResourceDictionary Source="Themes/DataGrids.xaml" />
                <ResourceDictionary Source="Themes/Tabs.xaml" />
                <ResourceDictionary Source="Themes/Cards.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Convertidores globales  -->
            <helpers:NotBooleanConverter x:Key="NotBooleanConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
