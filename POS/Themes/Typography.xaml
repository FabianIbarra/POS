<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Base tipográfica común a toda la aplicación  -->
    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!--  Título principal de ventana  -->
    <Style
        x:Key="WindowTitleStyle"
        BasedOn="{StaticResource BaseTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!--  Encabezado de sección (tarjetas)  -->
    <Style
        x:Key="SectionHeaderStyle"
        BasedOn="{StaticResource BaseTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!--  Título de tarjeta  -->
    <Style
        x:Key="CardTitleStyle"
        BasedOn="{StaticResource BaseTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!--  Subtítulo  -->
    <Style
        x:Key="SubtitleStyle"
        BasedOn="{StaticResource BaseTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!--  Etiqueta de campo de formulario  -->
    <Style
        x:Key="LabelTextStyle"
        BasedOn="{StaticResource BaseTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!--  Texto pequeño / secundario  -->
    <Style
        x:Key="SmallTextStyle"
        BasedOn="{StaticResource BaseTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!--  Valor numérico relevante (totales)  -->
    <Style
        x:Key="MetricValueStyle"
        BasedOn="{StaticResource BaseTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
</ResourceDictionary>
