<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Colores de Marca  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3498DB" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#5DADE2" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2E86C1" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1976D2" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#2ECC71" />
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#229954" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#4CAF50" />

    <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#EC7063" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#F44336" />

    <SolidColorBrush x:Key="WarningBrush" Color="#E67E22" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#EB984E" />
    <SolidColorBrush x:Key="WarningPressedBrush" Color="#D35400" />

    <SolidColorBrush x:Key="InfoBrush" Color="#2196F3" />
    <SolidColorBrush x:Key="InfoHoverBrush" Color="#42A5F5" />
    <SolidColorBrush x:Key="InfoPressedBrush" Color="#1E88E5" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#9E9E9E" />
    <SolidColorBrush x:Key="NeutralHoverBrush" Color="#BDBDBD" />
    <SolidColorBrush x:Key="NeutralPressedBrush" Color="#757575" />
    <SolidColorBrush x:Key="MintBrush" Color="#1ABC9C" />
    <SolidColorBrush x:Key="MintDarkBrush" Color="#16A085" />
    <SolidColorBrush x:Key="MintLightBrush" Color="#E8F8F5" />

    <!--  Fondos  -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F5F8FC" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D6EAF8" />
    <SolidColorBrush x:Key="SelectionHoverBrush" Color="#AED6F1" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#EFEFEF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#2C3E50" />
    <SolidColorBrush x:Key="SidebarDarkBrush" Color="#1A252F" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#34495E" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#E0E0E0" />

    <!--  Bordes  -->
    <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#BDC3C7" />

    <!--  Textos  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#888888" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#999999" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSidebarMutedBrush" Color="#95A5A6" />
    <SolidColorBrush x:Key="TextSidebarInactiveBrush" Color="#BDC3C7" />

    <!--  Error  -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#D32F2F" />
</ResourceDictionary>
