<UserControl
    x:Class="POS.Views.POSControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:POS.ViewModels"
    Background="#F5F5F5"
    FocusManager.FocusedElement="{Binding ElementName=TxtBuscador}">

    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CobrarVentaCommand}" />
        <KeyBinding Key="F5" Command="{Binding CancelarVentaCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding IncrementarCantidadCommand}" />
        <KeyBinding Key="Add" Command="{Binding IncrementarCantidadCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding DecrementarCantidadCommand}" />
        <KeyBinding Key="Subtract" Command="{Binding DecrementarCantidadCommand}" />
        <KeyBinding Key="Delete" Command="{Binding EliminarRenglonCommand}" />
        <KeyBinding Key="Up" Command="{Binding SeleccionarAnteriorCommand}" />
        <KeyBinding Key="Down" Command="{Binding SeleccionarSiguienteCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Cabecera y Buscador  -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Código de Barras:" />
                <Grid>
                    <TextBox
                        x:Name="TxtBuscador"
                        Width="350"
                        Height="40"
                        Padding="5,0"
                        VerticalContentAlignment="Center"
                        FontSize="18">
                        <TextBox.Text>
                            <Binding Path="CodigoEscaneado" UpdateSourceTrigger="PropertyChanged" />
                        </TextBox.Text>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AgregarProductoCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#999"
                        IsHitTestVisible="False"
                        Text="Escanea el código y presiona Enter">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtBuscador}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <!--  Panel de Atajos (Ayuda Visual)  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Margin="0,0,5,0"
                    Padding="8,4"
                    Background="#E0E0E0"
                    CornerRadius="3">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="F1 - Cobrar" />
                </Border>
                <Border
                    Margin="0,0,5,0"
                    Padding="8,4"
                    Background="#E0E0E0"
                    CornerRadius="3">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="Flechas - Navegar" />
                </Border>
                <Border
                    Margin="0,0,5,0"
                    Padding="8,4"
                    Background="#E0E0E0"
                    CornerRadius="3">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="+/- Cant." />
                </Border>
                <Border
                    Margin="0,0,5,0"
                    Padding="8,4"
                    Background="#E0E0E0"
                    CornerRadius="3">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="Supr - Quitar" />
                </Border>
                <Border
                    Padding="8,4"
                    Background="#E0E0E0"
                    CornerRadius="3">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="F5 - Cancelar" />
                </Border>
            </StackPanel>
        </Grid>

        <!--  Tabla del Carrito  -->
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            Background="White"
            BorderBrush="#CCC"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            FontSize="14"
            IsReadOnly="False"
            ItemsSource="{Binding Carrito}"
            RowHeight="35"
            SelectedItem="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding EliminarRenglonCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Descripcion}"
                    Header="Descripción"
                    IsReadOnly="True" />
                <DataGridTemplateColumn
                    Width="100"
                    Header="Cantidad"
                    IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Text="{Binding Cantidad}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                Margin="5,0"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding PrecioUnitario, StringFormat=C}"
                    Header="Precio Unit."
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Subtotal, StringFormat=C}"
                    Header="Subtotal"
                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  Desglose de Totales  -->
        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="15,10"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="1"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock
                            FontSize="12"
                            Foreground="#888"
                            Text="Subtotal sin IVA" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#333"
                            Text="{Binding SubtotalSinIVA, StringFormat=C}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="#888"
                            Text="IVA (16%)" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#E67E22"
                            Text="{Binding Iva, StringFormat=C}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        FontSize="28"
                        FontWeight="Bold"
                        Text="TOTAL:" />
                    <TextBlock
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        FontSize="36"
                        FontWeight="Bold"
                        Foreground="#4CAF50"
                        Text="{Binding TotalVenta, StringFormat=C}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Panel Inferior (Botones)  -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="200"
                Height="50"
                Background="#F44336"
                BorderThickness="0"
                Command="{Binding CancelarVentaCommand}"
                Content="Cancelar Venta (F5)"
                Cursor="Hand"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Width="200"
                    Height="60"
                    Background="#4CAF50"
                    BorderThickness="0"
                    Command="{Binding CobrarVentaCommand}"
                    Content="COBRAR (F1)"
                    Cursor="Hand"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
