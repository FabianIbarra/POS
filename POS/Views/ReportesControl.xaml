<UserControl
    x:Class="POS.Views.ReportesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Panel de Filtros  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,15"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SmallTextStyle}" Text="Fecha Inicio" />
                        <DatePicker SelectedDate="{Binding FechaInicio}" Style="{StaticResource DatePickerStyle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SmallTextStyle}" Text="Fecha Fin" />
                        <DatePicker SelectedDate="{Binding FechaFin}" Style="{StaticResource DatePickerStyle}" />
                    </StackPanel>
                    <Button
                        Margin="0,22,20,0"
                        Padding="15,0"
                        Command="{Binding BuscarPorFechasCommand}"
                        Content="Buscar por Fechas"
                        Style="{StaticResource InfoButtonStyle}" />
                    <Button
                        Margin="0,22,20,0"
                        Padding="15,0"
                        Command="{Binding CargarVentasDelDiaCommand}"
                        Content="Ventas del Día"
                        Style="{StaticResource SuccessButtonStyle}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SmallTextStyle}" Text="Buscar por Folio" />
                        <TextBox
                            Width="120"
                            Style="{StaticResource TextBoxStyle}"
                            Text="{Binding FolioBusqueda, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding BuscarPorFolioCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Margin="0,22,0,0"
                    Padding="15,0"
                    Command="{Binding BuscarPorFolioCommand}"
                    Content="Buscar Folio"
                    Style="{StaticResource WarningButtonStyle}" />
            </Grid>
        </Border>

        <!--  Resultados: Tabla + Detalle  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Tabla de Ventas  -->
            <Border
                Grid.Column="0"
                Padding="0"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="15,12"
                        Style="{StaticResource CardTitleStyle}"
                        Text="Ventas" />

                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding Ventas}"
                        RowHeight="34"
                        SelectedItem="{Binding VentaSeleccionada}"
                        Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Folio}"
                                Header="Folio" />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding FechaHora}"
                                Header="Fecha y Hora" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Total, StringFormat=C}"
                                Header="Total" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding MetodoPago}"
                                Header="Pago" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!--  Panel de Detalle  -->
            <Border
                Grid.Column="2"
                MinWidth="300"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding TieneResultados, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        Style="{StaticResource CardTitleStyle}"
                        Text="Detalle de Venta" />

                    <TextBlock Style="{StaticResource SmallTextStyle}" Text="Folio:" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding VentaSeleccionada.Folio, FallbackValue=---}" />

                    <TextBlock Style="{StaticResource SmallTextStyle}" Text="Fecha:" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding VentaSeleccionada.FechaHora, FallbackValue=---}" />

                    <TextBlock Style="{StaticResource SmallTextStyle}" Text="Total:" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource SuccessBrush}"
                        Text="{Binding VentaSeleccionada.Total, StringFormat=C, FallbackValue=---}" />

                    <TextBlock Style="{StaticResource SmallTextStyle}" Text="Método de Pago:" />
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding VentaSeleccionada.MetodoPago, FallbackValue=---}" />

                    <Border Style="{StaticResource DividerStyle}" />

                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Productos" />

                    <ItemsControl
                        MaxHeight="200"
                        FontSize="13"
                        ItemsSource="{Binding DetallesVenta}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Descripcion}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Text="{Binding Cantidad}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        Text="{Binding Subtotal, StringFormat=C}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Barra de Resumen  -->
        <Border
            Grid.Row="2"
            Margin="0,15,0,0"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding ResumenTexto}" />

                <TextBlock
                    Grid.Column="2"
                    FontSize="14"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="Total Ingresos:" />

                <TextBlock
                    Grid.Column="4"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{StaticResource SuccessBrush}"
                    Text="{Binding TotalIngresos, StringFormat=C}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
