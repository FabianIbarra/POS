<UserControl
    x:Class="POS.Views.UsuariosControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Panel Izquierdo: Formulario  -->
        <Border
            Grid.Column="0"
            Padding="15"
            Background="White"
            CornerRadius="5">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="Datos del Usuario" />

                <TextBlock
                    Margin="0,5,0,2"
                    FontSize="12"
                    Foreground="#666"
                    Text="Nombre de Usuario:" />
                <TextBox
                    Height="30"
                    Padding="5"
                    BorderBrush="#CCC"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,10,0,2"
                    FontSize="12"
                    Foreground="#666"
                    Text="Nombre Completo:" />
                <TextBox
                    Height="30"
                    Padding="5"
                    BorderBrush="#CCC"
                    Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,10,0,2"
                    FontSize="12"
                    Foreground="#666"
                    Text="Contraseña:" />
                <PasswordBox
                    x:Name="PasswordBoxContrasena"
                    Height="30"
                    Padding="5"
                    BorderBrush="#CCC"
                    PasswordChanged="PasswordBoxContrasena_PasswordChanged" />

                <TextBlock
                    Margin="0,10,0,2"
                    FontSize="12"
                    Foreground="#666"
                    Text="Rol:" />
                <ComboBox
                    Height="30"
                    Padding="5"
                    BorderBrush="#CCC"
                    ItemsSource="{Binding Roles}"
                    SelectedItem="{Binding RolSeleccionado}" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Height="35"
                        Background="#4CAF50"
                        BorderThickness="0"
                        Command="{Binding GuardarUsuarioCommand}"
                        Content="Guardar"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        Grid.Column="2"
                        Height="35"
                        Background="#9E9E9E"
                        BorderThickness="0"
                        Command="{Binding LimpiarFormularioCommand}"
                        Content="Limpiar"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Panel Derecho: Tabla  -->
        <Grid Grid.Column="2">
            <DataGrid
                AutoGenerateColumns="False"
                Background="White"
                BorderBrush="#CCC"
                CanUserAddRows="False"
                IsReadOnly="True"
                ItemsSource="{Binding Usuarios}"
                RowHeight="35">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Username}"
                        Header="Usuario" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding NombreCompleto}"
                        Header="Nombre Completo" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Rol}"
                        Header="Rol" />
                    <DataGridTemplateColumn Width="140" Header="Acciones">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,5,0"
                                        Padding="5,2"
                                        Background="#2196F3"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.SeleccionarUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="Editar"
                                        Cursor="Hand"
                                        Foreground="White" />
                                    <Button
                                        Padding="5,2"
                                        Background="#F44336"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.EliminarUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="Eliminar"
                                        Cursor="Hand"
                                        Foreground="White" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
