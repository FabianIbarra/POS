<UserControl
    x:Class="POS.Views.InventarioControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:POS.ViewModels"
    Background="#F5F5F5">

    <Grid Margin="15">
        <TabControl Background="Transparent" BorderThickness="0">

            <!--  PESTAÑA 1: PRODUCTOS  -->
            <TabItem
                FontSize="14"
                FontWeight="SemiBold"
                Header="Gestión de Productos">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Panel Izquierdo: Formulario  -->
                    <Border
                        Grid.Column="0"
                        Padding="15"
                        Background="White"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#333"
                                Text="Datos del Producto" />

                            <TextBlock
                                Margin="0,5,0,2"
                                FontSize="12"
                                Foreground="#666"
                                Text="Código de Barras:" />
                            <Grid>
                                <TextBox
                                    x:Name="TxtCodigoBarras"
                                    Height="30"
                                    Padding="5"
                                    BorderBrush="#CCC"
                                    Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#999999"
                                    IsHitTestVisible="False"
                                    Text="Escanea o ingresa el código del producto">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtCodigoBarras}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock
                                Margin="0,10,0,2"
                                FontSize="12"
                                Foreground="#666"
                                Text="Descripción:" />
                            <Grid>
                                <TextBox
                                    x:Name="TxtDescripcion"
                                    Height="30"
                                    Padding="5"
                                    BorderBrush="#CCC"
                                    Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#999999"
                                    IsHitTestVisible="False"
                                    Text="Describe el producto (ej. Coca-Cola 600ml)">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtDescripcion}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock
                                Margin="0,10,0,2"
                                FontSize="12"
                                Foreground="#666"
                                Text="Categoría:" />
                            <Grid>
                                <ComboBox
                                    x:Name="CmbCategoria"
                                    Height="30"
                                    Padding="5"
                                    BorderBrush="#CCC"
                                    DisplayMemberPath="Nombre"
                                    ItemsSource="{Binding Categorias}"
                                    SelectedItem="{Binding CategoriaSeleccionada}" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#999999"
                                    IsHitTestVisible="False"
                                    Text="Selecciona una categoría">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=CmbCategoria}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock
                                Margin="0,10,0,2"
                                FontSize="12"
                                Foreground="#666"
                                Text="Precio de Compra:" />
                            <TextBox
                                Height="30"
                                Padding="5"
                                BorderBrush="#CCC"
                                Text="{Binding PrecioCompra}" />

                            <TextBlock
                                Margin="0,10,0,2"
                                FontSize="12"
                                Foreground="#666"
                                Text="Precio de Venta:" />
                            <TextBox
                                Height="30"
                                Padding="5"
                                BorderBrush="#CCC"
                                Text="{Binding PrecioVenta}" />

                            <TextBlock
                                Margin="0,10,0,2"
                                FontSize="12"
                                Foreground="#666"
                                Text="Stock Actual:" />
                            <TextBox
                                Height="30"
                                Padding="5"
                                BorderBrush="#CCC"
                                Text="{Binding Stock}" />

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Height="35"
                                    Background="#4CAF50"
                                    BorderThickness="0"
                                    Command="{Binding GuardarProductoCommand}"
                                    Content="Guardar"
                                    Cursor="Hand"
                                    FontWeight="Bold"
                                    Foreground="White" />
                                <Button
                                    Grid.Column="2"
                                    Height="35"
                                    Background="#9E9E9E"
                                    BorderThickness="0"
                                    Command="{Binding LimpiarFormularioCommand}"
                                    Content="Limpiar"
                                    Cursor="Hand"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Panel Derecho: Buscador y Tabla  -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,15"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Buscar:" />
                            <TextBox
                                Width="300"
                                Height="30"
                                Padding="5"
                                BorderBrush="#CCC"
                                Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <DataGrid
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            Background="White"
                            BorderBrush="#CCC"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Productos}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding CodigoBarras}"
                                    Header="Código" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Descripcion}"
                                    Header="Descripción" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding PrecioVenta, StringFormat=C}"
                                    Header="Precio Venta" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Stock}"
                                    Header="Stock" />
                                <DataGridTemplateColumn Width="140" Header="Acciones">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button
                                                    Margin="0,0,5,0"
                                                    Padding="5,2"
                                                    Background="#2196F3"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.SeleccionarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Editar"
                                                    Cursor="Hand"
                                                    Foreground="White" />
                                                <Button
                                                    Padding="5,2"
                                                    Background="#F44336"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.EliminarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Eliminar"
                                                    Cursor="Hand"
                                                    Foreground="White" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!--  PESTAÑA 2: CATEGORÍAS  -->
            <TabItem
                FontSize="14"
                FontWeight="SemiBold"
                Header="Gestión de Categorias">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Formulario de Categorías  -->
                    <Border
                        Grid.Column="0"
                        Padding="15"
                        Background="White"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,15"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#333"
                                Text="Datos de la Categoría" />

                            <TextBlock
                                Margin="0,5,0,2"
                                FontSize="12"
                                Foreground="#666"
                                Text="Nombre:" />
                            <Grid>
                                <TextBox
                                    x:Name="TxtNombreCategoria"
                                    Height="30"
                                    Padding="5"
                                    BorderBrush="#CCC"
                                    Text="{Binding NombreCategoria, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#999999"
                                    IsHitTestVisible="False"
                                    Text="Ingresa el nombre de una nueva categoría">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtNombreCategoria}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Height="35"
                                    Background="#4CAF50"
                                    BorderThickness="0"
                                    Command="{Binding GuardarCategoriaCommand}"
                                    Content="Guardar"
                                    Cursor="Hand"
                                    FontWeight="Bold"
                                    Foreground="White" />
                                <Button
                                    Grid.Column="2"
                                    Height="35"
                                    Background="#9E9E9E"
                                    BorderThickness="0"
                                    Command="{Binding LimpiarFormularioCategoriaCommand}"
                                    Content="Limpiar"
                                    Cursor="Hand"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Tabla de Categorías  -->
                    <DataGrid
                        Grid.Column="2"
                        AutoGenerateColumns="False"
                        Background="White"
                        BorderBrush="#CCC"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Categorias}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Nombre}"
                                Header="Nombre de Categoría" />
                            <DataGridTemplateColumn Width="140" Header="Acciones">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,5,0"
                                                Padding="5,2"
                                                Background="#2196F3"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SeleccionarCategoriaParaEdicionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Editar"
                                                Cursor="Hand"
                                                Foreground="White" />
                                            <Button
                                                Padding="5,2"
                                                Background="#F44336"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.EliminarCategoriaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Eliminar"
                                                Cursor="Hand"
                                                Foreground="White" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
