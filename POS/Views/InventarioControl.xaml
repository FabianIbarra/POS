<UserControl
    x:Class="POS.Views.InventarioControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="15">
        <TabControl Style="{StaticResource TabControlStyle}">

            <!--  PESTAÑA 1: PRODUCTOS  -->
            <TabItem Header="Gestión de Productos" Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Formulario  -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,15"
                                Style="{StaticResource SectionHeaderStyle}"
                                Text="Datos del Producto" />

                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{StaticResource LabelTextStyle}"
                                Text="Código de Barras:" />
                            <Grid>
                                <TextBox
                                    x:Name="TxtCodigoBarras"
                                    Style="{StaticResource TextBoxStyle}"
                                    Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="12,0,0,0" Text="Escanea o ingresa el código del producto">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource PlaceholderTextStyle}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtCodigoBarras}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{StaticResource LabelTextStyle}"
                                Text="Descripción:" />
                            <Grid>
                                <TextBox
                                    x:Name="TxtDescripcion"
                                    Style="{StaticResource TextBoxStyle}"
                                    Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="12,0,0,0" Text="Describe el producto (ej. Coca-Cola 600ml)">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource PlaceholderTextStyle}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtDescripcion}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{StaticResource LabelTextStyle}"
                                Text="Categoría:" />
                            <Grid>
                                <ComboBox
                                    x:Name="CmbCategoria"
                                    DisplayMemberPath="Nombre"
                                    ItemsSource="{Binding Categorias}"
                                    SelectedItem="{Binding CategoriaSeleccionada}"
                                    Style="{StaticResource ComboBoxStyle}" />
                                <TextBlock Margin="12,0,0,0" Text="Selecciona una categoría">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource PlaceholderTextStyle}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=CmbCategoria}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{StaticResource LabelTextStyle}"
                                Text="Precio de Compra:" />
                            <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding PrecioCompra}" />

                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{StaticResource LabelTextStyle}"
                                Text="Precio de Venta:" />
                            <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding PrecioVenta}" />

                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{StaticResource LabelTextStyle}"
                                Text="Stock Actual:" />
                            <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Stock}" />

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding GuardarProductoCommand}"
                                    Content="Guardar"
                                    Style="{StaticResource SuccessButtonStyle}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding LimpiarFormularioCommand}"
                                    Content="Limpiar"
                                    Style="{StaticResource NeutralButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Buscador y Tabla  -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,15"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Buscar:" />
                            <TextBox
                                Width="300"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <DataGrid
                            Grid.Row="1"
                            ItemsSource="{Binding Productos}"
                            Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding CodigoBarras}"
                                    Header="Código" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Descripcion}"
                                    Header="Descripción" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding PrecioVenta, StringFormat=C}"
                                    Header="Precio Venta" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Stock}"
                                    Header="Stock" />
                                <DataGridTemplateColumn Width="140" Header="Acciones">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button
                                                    Margin="0,0,5,0"
                                                    Command="{Binding DataContext.SeleccionarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Editar"
                                                    Style="{StaticResource EditButtonStyle}" />
                                                <Button
                                                    Command="{Binding DataContext.EliminarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Eliminar"
                                                    Style="{StaticResource DeleteButtonStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!--  PESTAÑA 2: CATEGORÍAS  -->
            <TabItem Header="Gestión de Categorías" Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Formulario  -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,15"
                                Style="{StaticResource SectionHeaderStyle}"
                                Text="Datos de la Categoría" />

                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{StaticResource LabelTextStyle}"
                                Text="Nombre:" />
                            <Grid>
                                <TextBox
                                    x:Name="TxtNombreCategoria"
                                    Style="{StaticResource TextBoxStyle}"
                                    Text="{Binding NombreCategoria, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="12,0,0,0" Text="Ingresa el nombre de una nueva categoría">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource PlaceholderTextStyle}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtNombreCategoria}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding GuardarCategoriaCommand}"
                                    Content="Guardar"
                                    Style="{StaticResource SuccessButtonStyle}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding LimpiarFormularioCategoriaCommand}"
                                    Content="Limpiar"
                                    Style="{StaticResource NeutralButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Tabla  -->
                    <DataGrid
                        Grid.Column="2"
                        ItemsSource="{Binding Categorias}"
                        Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Nombre}"
                                Header="Nombre de Categoría" />
                            <DataGridTemplateColumn Width="140" Header="Acciones">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,5,0"
                                                Command="{Binding DataContext.SeleccionarCategoriaParaEdicionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Editar"
                                                Style="{StaticResource EditButtonStyle}" />
                                            <Button
                                                Command="{Binding DataContext.EliminarCategoriaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Eliminar"
                                                Style="{StaticResource DeleteButtonStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
