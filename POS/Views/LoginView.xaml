<Window
    x:Class="POS.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sistema POS - Login"
    Width="500"
    Height="410"
    Background="#F5F5F5"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="0,0,0,0">
        <StackPanel
            Width="380"
            Height="426"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <!--  Título  -->
            <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#333333"
                Text="Sistema POS" />

            <TextBlock
                Margin="0,0,0,30"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="#666666"
                Text="Ingresa tus credenciales para continuar" />

            <!--  Campo de Usuario  -->
            <TextBlock
                Margin="0,0,0,5"
                FontSize="12"
                Foreground="#333333"
                Text="Usuario:" />
            <Grid Margin="0,0,0,15">
                <TextBox
                    x:Name="UsernameTextBox"
                    Height="40"
                    Padding="12,10"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    FontSize="13"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Placeholder de Usuario con Trigger automático  -->
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#999999"
                    IsHitTestVisible="False"
                    Text="Escribe tu usuario">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=UsernameTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!--  Campo de Contraseña  -->
            <TextBlock
                Margin="0,0,0,5"
                FontSize="12"
                Foreground="#333333"
                Text="Contraseña:" />
            <Grid Margin="0,0,0,15">
                <PasswordBox
                    x:Name="PasswordBox"
                    Height="40"
                    Padding="12,10,35,10"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    FontSize="13"
                    PreviewKeyDown="Password_PreviewKeyDown" />

                <TextBox
                    x:Name="PasswordVisibleBox"
                    Height="40"
                    Padding="12,10,35,10"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    FontSize="13"
                    PreviewKeyDown="Password_PreviewKeyDown"
                    TextChanged="PasswordVisibleBox_TextChanged"
                    Visibility="Collapsed" />

                <!--  Placeholder de Contraseña (controlado desde C#)  -->
                <TextBlock
                    x:Name="PasswordPlaceholder"
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#999999"
                    IsHitTestVisible="False"
                    Text="Ingresa tu contraseña" />

                <Button
                    x:Name="BtnMostrarContrasena"
                    Width="30"
                    Height="30"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnMostrarContrasena_Click"
                    Content="👁"
                    Cursor="Hand" />
            </Grid>

            <!--  Mensaje de Error  -->
            <TextBlock
                MinHeight="20"
                Margin="0,0,0,15"
                FontSize="12"
                Foreground="#D32F2F"
                Text="{Binding MensajeError}"
                TextWrapping="Wrap" />
            <Button
                Height="40"
                Background="#1976D2"
                Command="{Binding AutenticarCommand}"
                Content="Iniciar Sesión"
                Cursor="Hand"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White"
                IsEnabled="{Binding IsLoading, Converter={StaticResource NotBooleanConverter}}" />

            <!--  Botón Único de Iniciar Sesión  -->

            <!--  Indicador de Carga  -->
            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar
                    Height="3"
                    Foreground="#1976D2"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#1976D2"
                    Text="{Binding MensajeEstado}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
