<Window
    x:Class="POS.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sistema POS - Login"
    Width="460"
    Height="500"
    Background="{StaticResource AppBackgroundBrush}"
    Icon="/POSLogo.png"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <!--  Tarjeta central  -->
        <Border
            Width="380"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="12"
            Style="{StaticResource CardStyle}">
            <StackPanel>
                <!--  Título  -->
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    Style="{StaticResource WindowTitleStyle}"
                    Text="Sistema POS" />

                <TextBlock
                    Margin="0,0,0,28"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleStyle}"
                    Text="Ingresa tus credenciales para continuar" />

                <!--  Campo de Usuario  -->
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource LabelTextStyle}"
                    Text="Usuario:" />
                <Grid Margin="0,0,0,14">
                    <TextBox
                        x:Name="UsernameTextBox"
                        Height="40"
                        Padding="6,0"
                        DataObject.Pasting="UsernameTextBox_Pasting"
                        KeyDown="UsernameTextBox_KeyDown"
                        PreviewTextInput="UsernameTextBox_PreviewTextInput"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="UsernameTextBox_TextChanged" />

                    <!--  Placeholder de Usuario  -->
                    <TextBlock Margin="15,0,0,0" Text="Escribe tu usuario">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource PlaceholderTextStyle}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=UsernameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!--  Campo de Contraseña  -->
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource LabelTextStyle}"
                    Text="Contraseña:" />
                <Grid Margin="0,0,0,14">
                    <PasswordBox
                        x:Name="PasswordBox"
                        Height="40"
                        Padding="6,0,35,0"
                        PreviewKeyDown="Password_PreviewKeyDown"
                        Style="{StaticResource PasswordBoxStyle}">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AutenticarCommand}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>

                    <TextBox
                        x:Name="PasswordVisibleBox"
                        Height="40"
                        Padding="6,0,35,0"
                        PreviewKeyDown="Password_PreviewKeyDown"
                        Style="{StaticResource TextBoxStyle}"
                        TextChanged="PasswordVisibleBox_TextChanged"
                        Visibility="Collapsed">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AutenticarCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!--  Placeholder de Contraseña  -->
                    <TextBlock
                        x:Name="PasswordPlaceholder"
                        Margin="15,0,0,0"
                        Style="{StaticResource PlaceholderTextStyle}"
                        Text="Ingresa tu contraseña" />

                    <!--  Botón de mostrar/ocultar  -->
                    <Button
                        x:Name="BtnMostrarContrasena"
                        Width="30"
                        Height="30"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnMostrarContrasena_Click"
                        Content="👁"
                        Cursor="Hand" />
                </Grid>

                <!--  Mensaje de Error  -->
                <TextBlock
                    MinHeight="18"
                    Margin="0,0,0,14"
                    Foreground="{StaticResource ErrorBrush}"
                    Style="{StaticResource SmallTextStyle}"
                    Text="{Binding MensajeError}"
                    TextWrapping="Wrap" />

                <!--  Botón de Iniciar Sesión  -->
                <Button
                    Height="42"
                    Command="{Binding AutenticarCommand}"
                    Content="Iniciar Sesión"
                    FontSize="14"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource NotBooleanConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}" />

                <!--  Indicador de Carga  -->
                <StackPanel
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar
                        Height="3"
                        Foreground="{StaticResource PrimaryBrush}"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Style="{StaticResource SmallTextStyle}"
                        Text="{Binding MensajeEstado}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
