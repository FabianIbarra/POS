<Window
    x:Class="POS.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:POS.Views"
    xmlns:vm="clr-namespace:POS.ViewModels"
    Title="Sistema POS - Principal"
    Width="1200"
    Height="800"
    Background="{StaticResource AppBackgroundBrush}"
    Icon="/POSLogo.png"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--  Mapeo de ViewModels a Views (UserControls)  -->
        <DataTemplate DataType="{x:Type vm:POSViewModel}">
            <views:POSControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventarioViewModel}">
            <views:InventarioControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
            <views:ReportesControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
            <views:UsuariosControl />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Barra lateral  -->
        <Border
            Grid.Column="0"
            Panel.ZIndex="1"
            Background="{StaticResource SidebarBrush}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Direction="0"
                    Opacity="0.2"
                    ShadowDepth="2"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Encabezado del Sistema  -->
                <StackPanel Grid.Row="0" Margin="20,30,20,30">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextOnDarkBrush}"
                        Text="Sistema POS" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="11"
                        Foreground="{StaticResource TextSidebarMutedBrush}"
                        Text="Administración de Ventas" />
                </StackPanel>

                <!--  Información del Usuario  -->
                <Border
                    Grid.Row="1"
                    Margin="15,0,15,30"
                    Padding="15,10"
                    Background="{StaticResource SidebarDarkBrush}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextOnDarkBrush}"
                            Text="{Binding NombreUsuario}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="{Binding RolUsuario}" />
                    </StackPanel>
                </Border>

                <!--  Navegación  -->
                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <Button Command="{Binding IrAPOSCommand}" Style="{StaticResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="|" />
                            <TextBlock Text="Punto de Venta" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding IrAInventarioCommand}"
                        Style="{StaticResource MenuButtonStyle}"
                        Visibility="{Binding EsAdministrador, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="|" />
                            <TextBlock Text="Inventario" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding IrAReportesCommand}"
                        Style="{StaticResource MenuButtonStyle}"
                        Visibility="{Binding EsAdministrador, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="|" />
                            <TextBlock Text="Reportes" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding IrAUsuariosCommand}"
                        Style="{StaticResource MenuButtonStyle}"
                        Visibility="{Binding EsAdministrador, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="|" />
                            <TextBlock Text="Usuarios" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Cerrar Sesión  -->
                <Button
                    Grid.Row="3"
                    Height="45"
                    Margin="15,0,15,20"
                    Command="{Binding CerrarSesionCommand}"
                    Content="Cerrar Sesión"
                    Style="{StaticResource LogoutButtonStyle}" />
            </Grid>
        </Border>

        <!--  Área de Contenido  -->
        <Border Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>
